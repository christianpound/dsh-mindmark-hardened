{
  "name": "@local/dsh-mindmark-hardened",
  "version": "0.4.1-hardened.1",
  "private": true,
  "engines": { "dsh": ">=0.2.2-rc.1" },
  "description": "Hardened MindMark fork: response annotations with DSH-authenticated access, session-isolated references, and human-approved global preferences.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "LICENSE",
    "docs/demo.gif",
    "CHANGELOG.md",
    "README.en.md",
    "SECURITY.md",
    "VALIDATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "annotation",
    "markup",
    "feedback",
    "human-in-the-loop",
    "intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianpound/dsh-mindmark-hardened.git"
  },
  "homepage": "https://github.com/christianpound/dsh-mindmark-hardened#readme",
  "bugs": {
    "url": "https://github.com/christianpound/dsh-mindmark-hardened/issues"
  },
  "author": "BaiKe-Zhang",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}
